# Postgres connection string for the dedup store.
# Required whenever at least one notifier below is enabled.
DATABASE_URL=postgresql://user:password@localhost:5432/smartnews

# Discord notifier — required only if notifiers.discord.enabled is true
# in config/sources.yaml.
DISCORD_WEBHOOK_URL=

# Telegram notifier — required only if notifiers.telegram.enabled is true
# in config/sources.yaml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini LLM filter — required only if filter.enabled is true and
# filter.provider is "gemini" (the default) in config/sources.yaml.
# Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq LLM filter — required only if filter.enabled is true and
# filter.provider is "groq" in config/sources.yaml.
# Free tier key: https://console.groq.com/keys
GROQ_API_KEY=
