# Set by compose.yaml; only needed when running the fetcher outside Docker.
DATABASE_URL=postgresql://smartnews:smartnews@localhost:5432/smartnews
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Only the keys for the providers used in config/transformer.yaml are required.
# Gemini free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free tier key: https://console.groq.com/keys
GROQ_API_KEY=
